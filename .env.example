# Скопируйте в .env и задайте свои значения. Файл .env в Git не попадает.
# Секрет подписи токенов (не короче 32 символов): python -c "import secrets;print(secrets.token_urlsafe(48))"
FISH_JWT_SECRET=
# Токен для вызовов между сервисами
FISH_SERVICE_TOKEN=
# Первый администратор (создаётся, если пользователей ещё нет). Если пароль пуст —
# он будет сгенерирован и записан в <данные>/users/INITIAL_ADMIN_PASSWORD.json
FISH_ADMIN_LOGIN=admin
FISH_ADMIN_PASSWORD=
# Число воркеров расчётов (одновременных расчётов)
FISH_WORKERS=2
# Порт, на котором открывается приложение
FISH_HTTP_PORT=8080
# Для внешнего доступа с HTTPS (docker-compose.public.yml): доменное имя сервера
FISH_DOMAIN=
