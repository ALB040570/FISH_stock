{
 "version": "1.0.3",
 "author": "FishStock",
 "entrypoint": "algorithm:run",
 "language": "python",
 "runtime": {
  "python": ">=3.11",
  "timeout_minutes": 20
 },
 "code": "stock_by_catch",
 "title_ru": "Уловистость сети и запас по уловам",
 "title_kk": "Аудың аулағыштығы және ауланым бойынша қор",
 "description": "Парабола уловистости сети, балансовая модель 12 колец, запас по каждому лову (сеть — балансовый метод, невод — метод площадей), годовой и окончательный запас (сеть + невод).",
 "requires": {
  "datasets": [
   "catches",
   "age_samples",
   "species_props",
   "yearly_conditions",
   "mean_weights",
   "npc_stock"
  ],
  "steps": [
   "seine_catchability"
  ]
 },
 "parameters": [
  {
   "code": "NET_MIN_AGE",
   "title_ru": "Первая возрастная группа в уловах сети",
   "type": "integer",
   "default": 2,
   "category": "fixed",
   "min": 1,
   "max": 5
  },
  {
   "code": "NET_END_LEFT",
   "title_ru": "Левый конец параболы c̄ − a1·(j_min − c¹)²",
   "type": "number",
   "default": 0.1,
   "category": "fixed",
   "min": 0,
   "max": 1
  },
  {
   "code": "NET_END_RIGHT",
   "title_ru": "Правый конец параболы c̄ − a2·(m1 − c¹)²",
   "type": "number",
   "default": 0.2,
   "category": "fixed",
   "min": 0,
   "max": 1
  },
  {
   "code": "NET_C_LOWER",
   "title_ru": "Нижняя граница c сети",
   "type": "number",
   "default": 0.1,
   "category": "fixed",
   "min": 0,
   "max": 1
  },
  {
   "code": "NET_C_UPPER",
   "title_ru": "Верхняя граница c сети",
   "type": "number",
   "default": 0.8,
   "category": "fixed",
   "min": 0,
   "max": 1
  },
  {
   "code": "NET_MIN_SAMPLE",
   "title_ru": "Мин. объём пробы, шт",
   "type": "integer",
   "default": 20,
   "category": "fixed",
   "min": 1
  },
  {
   "code": "NET_STOCK_FORMULA",
   "title_ru": "Формула запаса по сетям",
   "type": "enum",
   "default": "code",
   "category": "fixed",
   "enum": [
    {
     "value": "code",
     "title_ru": "X = Y·S / (σ·(V² − r0²)), r0 — половина длины сети"
    },
    {
     "value": "article",
     "title_ru": "X = Y·S / (π·V²·σ)"
    }
   ]
  },
  {
   "code": "COMBINE_GEARS",
   "title_ru": "Объединение сети и невода",
   "type": "enum",
   "default": "hauls",
   "category": "fixed",
   "enum": [
    {
     "value": "hauls",
     "title_ru": "средневзвешенное по числу ловов"
    },
    {
     "value": "mean",
     "title_ru": "простое среднее"
    }
   ]
  },
  {
   "code": "NPC_STOCK_MULTIPLIER",
   "title_ru": "Множитель оценки запаса НПЦ",
   "type": "number",
   "default": 1000,
   "category": "fixed",
   "min": 0
  }
 ],
 "outputs": [
  {
   "code": "yearly_stock",
   "title_ru": "Годовой запас",
   "format": "table"
  },
  {
   "code": "stock_by_age",
   "title_ru": "Окончательный запас по возрастам",
   "format": "table"
  },
  {
   "code": "net_coefficients",
   "title_ru": "Уловистость сети",
   "format": "table"
  },
  {
   "code": "catch_by_age",
   "title_ru": "Улов по ловам и возрастам",
   "format": "table"
  },
  {
   "code": "age_shares",
   "title_ru": "Доли возрастной пробы",
   "format": "table"
  },
  {
   "code": "*.nc",
   "title_ru": "Кубы NetCDF",
   "format": "nc"
  },
  {
   "code": "stock_by_catch.xlsx",
   "title_ru": "Excel",
   "format": "xlsx"
  }
 ],
 "changes": "1.0.3 (22.10.2026): описания и подписи параметров без номеров формул и ссылок на исходные материалы; формулы и результаты не изменены\n1.0.2 (21.10.2026): новые таблицы результата «Улов по ловам и возрастам» (Y_ijd) и «Доли возрастной пробы q_ij(t)» для мониторинга; формулы и результаты не изменены\n1.0.1 (20.10.2026): водоём без ловов одним из орудий (только сети) — окончательный запас по другому орудию; формулы не изменены"
}
